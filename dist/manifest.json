{
    "manifest_version": 3,
    "name": "YouTube Video Time Tracker",
    "version": "1.2",
    "description": "Tracks time watched and remaining on YouTube videos",
    "permissions": ["tabs", "storage", "scripting"],
    "host_permissions": ["*://*.youtube.com/*"],
    "background": {
      "scripts": ["src/background.js"],
      "type": "module"
    },
    "action": {
      "default_title": "YouTube Video Tracker",
      "default_popup": "index.html"
    },
    "icons": {
      "16": "icon/logo-16.png",
      "48": "icon/logo-48.png",
      "128": "icon/logo-128.png",
      "256": "icon/logo-256.png"
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "youtubeTimeTracker@sloth.com",
        "data_collection_permissions": {
          "required": ["none"]
        }
      }
    }
}